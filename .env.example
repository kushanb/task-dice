# Copy to .env and fill in from Firebase console -> Project settings ->
# Your apps -> Web app -> SDK setup and configuration -> Config.
#
# Format must be key=value. Flutter's .env parser rejects "key: value" with
# "Invalid property line".
#
# These are not secrets: a Firebase web config identifies the project rather
# than granting access, and it ships inside the JS bundle either way. Access is
# controlled by firestore.rules and the Authorized domains list.
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
